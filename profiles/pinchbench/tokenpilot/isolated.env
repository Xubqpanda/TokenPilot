# PinchBench TokenPilot, isolated session mode.
TOKENPILOT_SESSION_MODE="${TOKENPILOT_SESSION_MODE:-isolated}"
TOKENPILOT_ENABLE_REDUCTION="${TOKENPILOT_ENABLE_REDUCTION:-true}"
TOKENPILOT_ENABLE_EVICTION="${TOKENPILOT_ENABLE_EVICTION:-true}"
TOKENPILOT_TASK_STATE_ESTIMATOR_ENABLED="${TOKENPILOT_TASK_STATE_ESTIMATOR_ENABLED:-true}"
TOKENPILOT_MEMORY_ENABLED="${TOKENPILOT_MEMORY_ENABLED:-true}"
